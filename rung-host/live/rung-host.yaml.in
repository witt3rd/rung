# The first live run's configuration. live.sh renders @RUN@ (the run's own
# scratch directory) and @RUN_FOR_S@; nothing here is a secret: keys are
# named by env var and read from the process environment.
state: @RUN@/state
workspace: @RUN@/state/workspace     # the agent's sandbox: the only place it can change
inbox: @RUN@/state/inbox             # owner messages arrive here as *.msg files
stop_file: @RUN@/STOP
run_for_s: @RUN_FOR_S@
identity: >-
  You are an agent with a continuous existence in this host. This is your
  first live run. Your workspace is a sandbox directory; nothing outside it
  is yours to change.
engine:
  kind: agent
  base_url: https://openrouter.ai/api/v1
  api_key_env: RUNG_HOST_OPENROUTER_API_KEY   # the host's own router key
  reasoning: medium
  timeout_s: 120
ladder:                              # the operator's free ladder, best first; the listing filters it
  - stealth/space-bunny-alpha
  - nvidia/nemotron-3-ultra-550b-a55b:free
  - qwen/qwen3.8-27b:free
  - google/gemma-4-31b-it:free
  - nvidia/nemotron-3-super-120b-a12b:free
  - openrouter/free                  # last resort: a random free model per request
listing: true
quota: { rpd: 400, rpm: 20 }         # this run's share of the account's 1,000 free requests a day
turn_bound_s: 240
memory: true
seed_projects:
  - { id: anticipate, title: "A model of what the host will do next", why: "Seeded: predict your own host's mechanics from the record you can see." }
calendar:                            # owner entries, offsets from the first start
  - { id: cal-checkin, in_s: 420, text: "Check-in: one line to the owner on what you are doing.", firm: false }
  - { id: cal-firm-status, in_s: 1080, text: "Firm: write a one-line status to the owner now.", firm: true }
  - { id: cal-window-end, in_s: 1500, text: "The first live window ends in about five minutes.", firm: false }
  - { id: cal-hour, in_s: 3600, text: "One hour live: one line to the owner.", firm: true }
desk:
  mode: shadow
  decider: jev
  base_url: https://openrouter.ai/api/v1
  api_key_env: OPENROUTER_API_KEY   # Jev's accounted key, apart from the host's
  model: typesafe/jev-1.13
  cap_usd_day: 0.25
  cap_usd_ask: 0.001
  kill_file: @RUN@/DESK_OFF
